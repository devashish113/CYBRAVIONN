# Production Microservice Dockerfile for CYBRAVION Visitor Telemetry API
FROM node:22-alpine

# Set deployment metadata & environment
ENV NODE_ENV=production \
    PORT=5000 \
    DATA_DIR=/app/data

WORKDIR /app

# Ensure unprivileged user owns the data directory
RUN mkdir -p /app/data && chown -R node:node /app

# Copy application script
COPY --chown=node:node visitor-service.mjs ./

# Switch to unprivileged user
USER node

# Expose internal service port
EXPOSE 5000

# Native container healthcheck
HEALTHCHECK --interval=20s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:5000/health || exit 1

# Start visitor service
CMD ["node", "visitor-service.mjs"]
